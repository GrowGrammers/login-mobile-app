{
  "extends": "@react-native/typescript-config",
  "include": ["src/**/*.ts", "src/**/*.tsx", "App.tsx", "index.js"],
  "exclude": [
    "**/node_modules/**",
    "**/Pods/**",
    "**/build/**",
    "**/dist/**",
    "android/**",
    "ios/**"
  ],
  "compilerOptions": {
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types"]
  }
}
